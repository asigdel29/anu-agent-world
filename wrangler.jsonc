{
  // The relay: a Worker fronting one SQLite-backed Durable Object.
  //
  // SQLite is the only Durable Object storage class the free plan allows, and
  // it is also what the agent tier needs later for its ledger and event log,
  // so there is no migration between "cheap now" and "capable later".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anu-agent-world",
  "main": "server/worker.ts",
  "compatibility_date": "2026-06-19",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "WorldRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldRoom"] }]
}
